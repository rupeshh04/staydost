# # StayDost — Environment Variables
# # Copy this file to .env and fill in your values

# # Server
# PORT=5000
# NODE_ENV=development

# # MongoDB
# MONGODB_URI=mongodb://localhost:27017/staydost

# # JWT
# JWT_SECRET=staydost_super_secret_jwt_key_change_in_production_2024
# JWT_EXPIRE=7d

# # Frontend URL (for CORS)
# CLIENT_URL=http://localhost:5173

# # Cloudinary (optional — for image uploads)
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# # Admin WhatsApp number (without + prefix, e.g. 917279937535)
# ADMIN_WHATSAPP=917279937535

# # Admin Email & Phone
# ADMIN_EMAIL=admin@staydost.com
# ADMIN_PHONE=+91 7279937535
